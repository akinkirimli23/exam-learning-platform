# Required on Vercel: persistent, TLS-enabled PostgreSQL connection (use a serverless pooler).
# Empty DATABASE_URL uses local PGlite; this is only for local development.
DATABASE_URL=
# Local development only. Do not set DATA_DIR on Vercel.
DATA_DIR=./data
# Exact public HTTPS origin on Vercel, without a trailing slash.
APP_ORIGIN=http://localhost:3000
# Set true for the current demo-content pilot; false hides demo catalog entries.
DEMO_CONTENT=true
# Optional server-side AI gateway (documented in docs/AI.md)
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=10
AI_DAILY_TOKEN_LIMIT=12000
# Optional admin media storage. All credentials must be set together when uploads are used on Vercel.
# The current upload/download API is still subject to Vercel's 4.5 MB function payload limit.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required for pilot learning media; server-only (never use NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
