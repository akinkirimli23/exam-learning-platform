# Empty DATABASE_URL uses persistent embedded PostgreSQL in ./data/database.
DATABASE_URL=
DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
# Local pilot only. Set false for reviewed, non-demo content exclusively.
DEMO_CONTENT=true
# Optional server-side AI gateway (documented in docs/AI.md)
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=10
AI_DAILY_TOKEN_LIMIT=12000
# S3-compatible object storage; local disk when unset
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public, read-only learning media URLs (provider-agnostic object storage/CDN)
NEXT_PUBLIC_BUOYANCY_VIDEO_URL=
NEXT_PUBLIC_BUOYANCY_VIDEO_THUMBNAIL_URL=
NEXT_PUBLIC_BUOYANCY_SLIDES_URL=
NEXT_PUBLIC_BUOYANCY_INFOGRAPHIC_URL=
